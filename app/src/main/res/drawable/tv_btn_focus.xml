<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bouton sélectionné -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="#FF1A2540" />

            <stroke
                android:width="2dp"
                android:color="#FF9B5CFF" />

            <corners android:radius="12dp" />

        </shape>
    </item>

    <!-- Bouton normal -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FF111A2E" />

            <stroke
                android:width="1dp"
                android:color="#FF283653" />

            <corners android:radius="12dp" />

        </shape>
    </item>

</selector>
