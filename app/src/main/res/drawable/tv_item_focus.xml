<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Élément sélectionné ou ciblé -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#331A2E55" />
            <stroke
                android:width="2dp"
                android:color="#FF9B5CFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Élément pressé -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#557C6FFF" />
            <stroke
                android:width="1dp"
                android:color="#FF7C6FFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Apparence normale -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
